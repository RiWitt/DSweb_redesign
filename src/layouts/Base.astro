---
import { Font } from 'astro:assets';
import Ticker from '../components/Ticker.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, languages, contact, type Lang, type PageKey } from '../i18n/ui';
import { pageUrl, asset } from '../lib/links';
import '../styles/global.css';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
}

const { lang, page, title, description } = Astro.props;
const t = ui[lang];

const canonical = new URL(pageUrl(lang, page), Astro.site);
const ogImage = new URL(asset('og-image.jpg'), Astro.site);

/* Organisation schema, emitted once per page. Gives search engines the
   registered name, address and contact details as data rather than as text
   they have to infer from the footer. */
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: contact.company,
  alternateName: 'ALCASYS DS',
  url: new URL(pageUrl(lang, 'home'), Astro.site).href,
  logo: new URL(asset('icon-512.png'), Astro.site).href,
  image: ogImage.href,
  email: contact.email,
  telephone: contact.phone,
  vatID: contact.icDph,
  taxID: contact.dic,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.street,
    addressLocality: 'Bratislava',
    postalCode: contact.city.split(' ').slice(0, 2).join(' '),
    addressCountry: 'SK',
  },
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* SVG first for the crisp modern path; the PNGs cover Safari and the
        add-to-homescreen icon. */}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('icon-192.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <meta name="theme-color" content="#BC2B2F" />

    {/* Tell search engines about the other language version of this same page. */}
    {
      languages.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(pageUrl(l, page), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(pageUrl('sk', page), Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ALCASYS DS" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'sk' ? 'sk_SK' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'sk' ? 'en_GB' : 'sk_SK'} />
    {/* `summary_large_image` promises an image; without these the card
        rendered as a bare link. 1200x630 is the size both networks crop to. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.ogImageAlt} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(orgSchema)}
    />

    {/*
      Self-hosted, downloaded at build time — no request to Google at runtime.

      Only the display face is preloaded — it renders the large h1, the LCP
      text. Preloading all three families would put ~240 kB ahead of the hero
      image for no benefit: the @font-face rules are inlined in this <head>,
      so the browser discovers body/mono immediately anyway and fetches them
      via `font-display: swap`.

      Both `latin` and `latin-ext` are preloaded — Slovak headings need the
      diacritics, so latin-ext is critical here, not optional.
    */}
    <Font
      cssVariable="--font-display"
      preload={[{ subset: 'latin' }, { subset: 'latin-ext' }]}
    />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
  <script is:inline>
    /* Turn smooth scrolling on only after the browser has finished its own
       jump to the URL fragment. With `scroll-behavior:smooth` set in CSS from
       the start, arriving from another page on e.g. `index.html#cyber`
       animated the whole way down from the top; now that arrival is instant
       and in-page anchor clicks still glide. */
    addEventListener('load', () => {
      requestAnimationFrame(() => document.documentElement.classList.add('smooth-scroll'));
    });
  </script>
  </head>

  <body>
    <a class="visually-hidden skip-link" href="#main">{t.skipToContent}</a>
    <Ticker lang={lang} />
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
  </body>
</html>
