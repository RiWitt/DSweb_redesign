---
interface Props {
  name: 'display' | 'network' | 'shield';
}

const { name } = Astro.props;
---

<div class="value-icon">
  {
    name === 'display' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <rect x="6" y="9" width="36" height="24" rx="3" />
        <line x1="16" y1="40" x2="32" y2="40" />
        <line x1="24" y1="33" x2="24" y2="40" />
        <line x1="13" y1="17" x2="35" y2="17" stroke-width="2" />
        <line x1="13" y1="23" x2="27" y2="23" stroke-width="2" />
      </svg>
    )
  }
  {
    name === 'network' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <circle cx="24" cy="11" r="5" />
        <circle cx="10" cy="36" r="5" />
        <circle cx="38" cy="36" r="5" />
        <line x1="24" y1="16" x2="12" y2="32" stroke-width="2" />
        <line x1="24" y1="16" x2="36" y2="32" stroke-width="2" />
        <line x1="15" y1="36" x2="33" y2="36" stroke-width="2" />
      </svg>
    )
  }
  {
    name === 'shield' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M24 6 L40 12 V23 C40 33 33 39 24 42 C15 39 8 33 8 23 V12 Z" />
        <path d="M16 23 L21 28 L31 17" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
</div>
