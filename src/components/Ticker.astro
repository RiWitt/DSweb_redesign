---
import { ui, contact, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

{/* A landmark, not a bare div: it sits outside <header> (it does not stick),
    so without one its contact details belong to no region of the page. */}
<aside class="ticker" aria-label={t.tickerLabel}>
  <div class="wrap">
    <div class="status"><span class="dot"></span>{t.tickerStatus}</div>
    {/* The icons are decoration: the link text already says "info@…" and the
        number, so labelling them would make a screen reader announce each
        contact twice. They replace the "·" that used to separate the pair. */}
    <div class="ticker-contact">
      <a href={`mailto:${contact.email}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="M22 6 12 13 2 6" />
        </svg>
        {contact.email}
      </a>
      <a href={`tel:${contact.phoneHref}`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        {contact.phone}
      </a>
    </div>
  </div>
</aside>
