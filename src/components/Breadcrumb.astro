---
import { ui, type Lang, type PageKey } from '../i18n/ui';
import { pageUrl } from '../lib/links';

interface Props {
  lang: Lang;
  page: PageKey;
  /** Trail after "Home"; the last entry renders as plain text, not a link. */
  trail: Array<{ label: string; href?: string }>;
}

const { lang, trail } = Astro.props;
const t = ui[lang];
---

{/* Sits inside the sub-hero band. It previously floated on white above it,
    which left it looking like an orphaned line of grey text. */}
<nav class="breadcrumb" aria-label={t.breadcrumbLabel}>
  <ol>
    <li><a href={pageUrl(lang, 'home')}>{t.breadcrumbHome}</a></li>
    {
      trail.map((item, i) => (
        <li>
          {item.href ? (
            <a href={item.href}>{item.label}</a>
          ) : (
            <span aria-current={i === trail.length - 1 ? 'page' : undefined}>{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
