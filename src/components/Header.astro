---
import Img from './Img.astro';
import { ui, contact, type Lang, type PageKey } from '../i18n/ui';
import { pageUrl, homeAnchor, asset } from '../lib/links';

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const t = ui[lang];

const navItems = [
  { href: pageUrl(lang, 'pis'), label: t.navPis, primary: true },
  { href: homeAnchor(lang, page, 'infra'), label: t.navInfra, primary: false },
  { href: homeAnchor(lang, page, 'cyber'), label: t.navCyber, primary: false },
];

const ctaHref = homeAnchor(lang, page, 'kontakt');

const langs = [
  { code: 'sk' as const, label: 'Slovenčina', short: 'SK', flag: 'flag-sk.gif' },
  { code: 'en' as const, label: 'English', short: 'EN', flag: 'flag-en.gif' },
];
---

<header>
  <div class="wrap nav-inner">
    <a href={pageUrl(lang, 'home')}>
      <Img class="logo-img" src="logo-alcasysds.png" alt="ALCASYS DS" widths={[260, 500]} sizes="260px" loading="eager" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={t.menuLabel}>
      <span class="nav-toggle-bars"></span>
    </button>

    <nav id="site-nav" aria-label={t.menuLabel}>
      {/* Drawer-only chrome; hidden at desktop width. */}
      <div class="nav-drawer-head">
        <span class="drawer-title">{t.menuLabel}</span>
        <button class="nav-close" type="button" aria-label={t.closeMenu}>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <line x1="4" y1="4" x2="16" y2="16" stroke-linecap="round" />
            <line x1="16" y1="4" x2="4" y2="16" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class={item.primary ? 'nav-primary' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav-cta-mobile">
        <a class="cta" href={ctaHref}>{t.navCta}</a>
      </div>

      {/* Language picker lives inside the drawer on mobile. */}
      <div class="nav-drawer-foot">
        <div class="drawer-title">{t.languageLabel}</div>
        <div class="lang-switch">
          {
            langs.map((l) => (
              <a
                class={lang === l.code ? 'active' : undefined}
                href={pageUrl(l.code, page)}
                hreflang={l.code}
                aria-label={l.label}
              >
                <img src={asset(`images/${l.flag}`)} alt="" width="24" height="16" />
                {l.short}
              </a>
            ))
          }
        </div>
        <div class="drawer-contact">
          <a href={`mailto:${contact.email}`}>{contact.email}</a><br />
          <a href={`tel:${contact.phoneHref}`}>{contact.phone}</a>
        </div>
      </div>
    </nav>

    <a class="cta cta-desktop" href={ctaHref}>{t.navCta}</a>

    <div class="lang-switch">
      {
        langs.map((l) => (
          <a
            class={lang === l.code ? 'active' : undefined}
            href={pageUrl(l.code, page)}
            hreflang={l.code}
            aria-label={l.label}
          >
            <img src={asset(`images/${l.flag}`)} alt={l.short} width="24" height="16" />
          </a>
        ))
      }
    </div>
  </div>
</header>

<div class="nav-scrim" hidden></div>

{/* Without JS the drawer can never be opened, so show the links inline instead. */}
<noscript>
  <style>
    @media (max-width: 900px) {
      .nav-toggle { display: none; }
      #site-nav { position: static; transform: none; box-shadow: none; width: auto; }
      .nav-drawer-head { display: none; }
    }
  </style>
</noscript>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  const scrim = document.querySelector<HTMLElement>('.nav-scrim');
  const closeBtn = document.querySelector<HTMLButtonElement>('.nav-close');

  if (toggle && nav && scrim) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const focusables = () =>
      Array.from(
        nav.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ).filter((el) => el.offsetParent !== null);

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
      scrim.hidden = !open;
      document.body.classList.toggle('nav-open', open);
      if (open) focusables()[0]?.focus();
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    closeBtn?.addEventListener('click', () => {
      setOpen(false);
      toggle.focus();
    });
    scrim.addEventListener('click', () => setOpen(false));

    // Anchor links keep you on the page, so close the drawer explicitly.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }

      // Keep focus inside the drawer while it covers the page.
      if (event.key === 'Tab') {
        const items = focusables();
        if (!items.length) return;
        const first = items[0]!;
        const last = items[items.length - 1]!;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    // Resizing up to desktop would otherwise leave `body.nav-open` stuck.
    window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
