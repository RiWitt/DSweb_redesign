---
import Img from './Img.astro';
import { ui, contact, type Lang, type PageKey } from '../i18n/ui';
import { pageUrl, homeAnchor, asset } from '../lib/links';

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const t = ui[lang];

const navItems = [
  { href: pageUrl(lang, 'pis'), label: t.navPis, primary: true },
  { href: homeAnchor(lang, page, 'infra'), label: t.navInfra, primary: false },
  { href: homeAnchor(lang, page, 'cyber'), label: t.navCyber, primary: false },
];

const ctaHref = homeAnchor(lang, page, 'kontakt');

const current = { sk: 'SK', en: 'EN' }[lang];

const langs = [
  { code: 'sk' as const, label: 'Slovenčina', short: 'SK', flag: 'flag-sk.gif' },
  { code: 'en' as const, label: 'English', short: 'EN', flag: 'flag-en.gif' },
];
---

<header>
  <div class="wrap nav-inner">
    <a href={pageUrl(lang, 'home')}>
      <Img class="logo-img" src="logo-alcasysds.png" alt="ALCASYS DS" widths={[260, 500]} sizes="260px" loading="eager" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={t.menuLabel}>
      <span class="nav-toggle-bars"></span>
    </button>

    <nav id="site-nav" aria-label={t.menuLabel}>
      {/* Drawer-only chrome; hidden at desktop width. */}
      <div class="nav-drawer-head">
        <span class="drawer-title">{t.menuLabel}</span>
        <button class="nav-close" type="button" aria-label={t.closeMenu}>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <line x1="4" y1="4" x2="16" y2="16" stroke-linecap="round" />
            <line x1="16" y1="4" x2="4" y2="16" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class={item.primary ? 'nav-primary' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="nav-cta-mobile">
        <a class="cta" href={ctaHref}>{t.navCta}</a>
      </div>

      {/* Language picker lives inside the drawer on mobile. */}
      <div class="nav-drawer-foot">
        <div class="drawer-title">{t.languageLabel}</div>
        <div class="lang-switch">
          {
            langs.map((l) => (
              <a
                class={lang === l.code ? 'active' : undefined}
                href={pageUrl(l.code, page)}
                hreflang={l.code}
                aria-label={l.label}
              >
                <img src={asset(`images/${l.flag}`)} alt="" width="24" height="16" />
                {l.short}
              </a>
            ))
          }
        </div>
        <div class="drawer-contact">
          <a href={`mailto:${contact.email}`}>{contact.email}</a><br />
          <a href={`tel:${contact.phoneHref}`}>{contact.phone}</a>
        </div>
      </div>
    </nav>

    {/* <details> gives a working dropdown with no JS at all — the script below
        only adds outside-click and Escape, which native <details> lacks. */}
    <details class="lang-menu">
      <summary aria-label={`${t.languageLabel}: ${current}`}>
        <img src={asset(`images/${langs.find((l) => l.code === lang)!.flag}`)} alt="" width="24" height="16" />
        <span>{current}</span>
        <svg class="lang-caret" width="10" height="7" viewBox="0 0 10 7" fill="none" aria-hidden="true">
          <path d="M1 1.5 L5 5.5 L9 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <ul>
        {
          langs.map((l) => (
            <li>
              <a
                href={pageUrl(l.code, page)}
                hreflang={l.code}
                lang={l.code}
                aria-current={lang === l.code ? 'true' : undefined}
              >
                <img src={asset(`images/${l.flag}`)} alt="" width="24" height="16" />
                <span>{l.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>

    <a class="cta cta-desktop" href={ctaHref}>{t.navCta}</a>
  </div>
</header>

{/* Without JS the drawer can never be opened, so show the links inline instead. */}
<noscript>
  <style>
    @media (max-width: 900px) {
      .nav-toggle { display: none; }
      #site-nav { position: static; transform: none; box-shadow: none; width: auto; }
      .nav-drawer-head { display: none; }
    }
  </style>
</noscript>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  const scrim = document.querySelector<HTMLElement>('.nav-scrim');
  const closeBtn = document.querySelector<HTMLButtonElement>('.nav-close');

  if (toggle && nav && scrim) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const focusables = () =>
      Array.from(
        nav.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ).filter((el) => el.offsetParent !== null);

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.toggleAttribute('data-open', open);
      scrim.hidden = !open;
      document.body.classList.toggle('nav-open', open);
      if (open) focusables()[0]?.focus();
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    closeBtn?.addEventListener('click', () => {
      setOpen(false);
      toggle.focus();
    });
    scrim.addEventListener('click', () => setOpen(false));

    // Anchor links keep you on the page, so close the drawer explicitly.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }

      // Keep focus inside the drawer while it covers the page.
      if (event.key === 'Tab') {
        const items = focusables();
        if (!items.length) return;
        const first = items[0]!;
        const last = items[items.length - 1]!;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    // Resizing up to desktop would otherwise leave `body.nav-open` stuck.
    window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }

  /* Section highlighting. Only the homepage has nav links that are bare
     fragments — homeAnchor() emits a full path from every other page — so this
     needs no page check: elsewhere the selector simply matches nothing. */
  const spied = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#site-nav a[href^="#"]'),
  )
    .map((link) => ({ link, section: document.getElementById(link.hash.slice(1)) }))
    .filter((entry): entry is { link: HTMLAnchorElement; section: HTMLElement } =>
      entry.section !== null,
    );

  if (spied.length) {
    const header = document.querySelector('header');

    const update = () => {
      // Match against the line the sticky header leaves exposed, not the
      // viewport top, or a section counts as current while hidden behind it.
      const line = (header?.getBoundingClientRect().height ?? 0) + 12;

      // A section is current only while it straddles that line. Ranges that
      // belong to no nav item — the hero, the credentials block below #cyber —
      // then correctly highlight nothing, rather than leaving the last
      // section lit for the rest of the page.
      const active = spied.find(({ section }) => {
        const { top, bottom } = section.getBoundingClientRect();
        return top <= line && bottom > line;
      });

      for (const entry of spied) {
        if (entry === active) entry.link.setAttribute('aria-current', 'location');
        else entry.link.removeAttribute('aria-current');
      }
    };

    // Scroll fires far faster than paint; coalesce to one read per frame so
    // the loop stays off the critical path.
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  }

  /* Contact strip: hidden while reading downwards, returned on scroll up. */
  const headbar = document.querySelector<HTMLElement>('.headbar');
  const ticker = headbar?.querySelector<HTMLElement>('.ticker');

  if (headbar && ticker) {
    // The strip is not a fixed height — it wraps to two rows on narrow phones
    // — so the collapse distance is measured rather than hard-coded.
    const publishHeight = () =>
      document.documentElement.style.setProperty('--ticker-h', `${ticker.offsetHeight}px`);
    publishHeight();
    if ('ResizeObserver' in window) new ResizeObserver(publishHeight).observe(ticker);

    // Upward travel required before the strip comes back, so that the flicks
    // and rubber-banding inside a downward read do not keep summoning it.
    const REVEAL_AFTER = 44;
    // Close to the top the strip simply belongs on screen.
    const ALWAYS_OPEN_TO = 64;

    const compact = (on: boolean) => document.body.classList.toggle('head-compact', on);

    let lastY = scrollY;
    let travelledUp = 0;
    let held = false;
    let release = 0;

    const read = () => {
      const y = Math.max(0, scrollY);
      const delta = y - lastY;
      lastY = y;
      if (held) return;

      if (y <= ALWAYS_OPEN_TO) {
        travelledUp = 0;
        compact(false);
      } else if (delta > 0) {
        travelledUp = 0;
        compact(true);
      } else if (delta < 0) {
        travelledUp -= delta;
        if (travelledUp >= REVEAL_AFTER) compact(false);
      }
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        read();
      });
    };
    addEventListener('scroll', onScroll, { passive: true });

    /* Clicking an in-page anchor scrolls upwards, which would reveal the strip
       and leave it sitting over the heading you just jumped to: every
       scroll-margin-top in the stylesheet is measured against the header on its
       own. So pin the collapsed state until the jump has settled. */
    const holdCollapsed = () => {
      held = true;
      travelledUp = 0;
      compact(true);
      clearTimeout(release);
      release = window.setTimeout(() => {
        held = false;
        lastY = scrollY;
        travelledUp = 0;
        read();
      }, 700);
    };

    document.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest?.('a[href*="#"]');
      if (!(link instanceof HTMLAnchorElement) || !link.hash) return;
      // Same-document jumps only — a cross-page link takes its own scroll
      // position with it and never scrolls this page upwards.
      if (link.pathname === location.pathname && link.host === location.host) holdCollapsed();
    });

    // Arriving on `…#cyber` lands mid-page with no scroll event to react to.
    if (scrollY > ALWAYS_OPEN_TO) compact(true);
    read();
  }

  /* <details> handles open/close and keyboard activation itself; these are the
     two behaviours it does not provide. */
  const langMenu = document.querySelector<HTMLDetailsElement>('.lang-menu');
  if (langMenu) {
    document.addEventListener('click', (event) => {
      if (langMenu.open && !langMenu.contains(event.target as Node)) langMenu.open = false;
    });
    langMenu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && langMenu.open) {
        langMenu.open = false;
        langMenu.querySelector('summary')?.focus();
      }
    });
  }
</script>