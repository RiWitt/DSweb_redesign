---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import FinalCta from '../components/FinalCta.astro';
import { momis } from '../content/pages';
import type { Lang } from '../i18n/ui';
import { homeAnchor } from '../lib/links';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = momis[lang];
const backHref = homeAnchor(lang, 'pis', 'pis');

const wifiShots = ['momis-wifi-0.jpg', 'momis-wifi-1.jpg', 'momis-wifi-2.jpg', 'momis-wifi-3.jpg'];
const cameraShots = ['momis-kamery-1.jpg', 'momis-kamery-2.jpg', 'momis-kamery-3.jpg'];

---

<Base lang={lang} page="pis" title={c.title} description={c.description}>
  <section class="sub-hero">
    <div class="wrap">
      <Breadcrumb
        lang={lang}
        page="pis"
        trail={[{ label: c.breadcrumbSection, href: backHref }, { label: 'MOMIS' }]}
      />
      <div class="eyebrow">{c.eyebrow}</div>
      <h1>{c.heading}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </section>

  <section class="sub-section momis-intro">
    <div class="wrap">
      <div class="about-intro">
        <div>
          <span class="sec-label">{c.sectionLabel}</span>
          <h2>{c.sectionHeading}</h2>
        </div>
        <p class="desc">{c.sectionDesc}</p>
      </div>
    </div>
  </section>

  {/* --- Chapter 1: what the passenger sees ------------------------- */}
  <section class="mgroup mgroup--tint">
    <div class="wrap">
      <h2>{c.groupPassenger}</h2>

      <div class="mrow" id="wifi">
        <span class="dt-num">{c.wifiNum}</span>
        <h3>{c.wifiHeading}</h3>
        <p>{c.wifiDesc}</p>
        <div class="mrow-media mrow-media--phones">
          {
            wifiShots.map((src, i) => (
              <Img
                src={src}
                alt={c.wifiAlts[i]!}
                widths={[140, 280, 420]}
                sizes="(max-width: 600px) 45vw, 140px"
              />
            ))
          }
        </div>
      </div>

      <div class="mrow" id="displeje">
        <span class="dt-num">{c.displayNum}</span>
        <h3>{c.displayHeading}</h3>
        <p>{c.displayDesc}</p>
        <div class="mrow-media mrow-media--2">
          <Img
            src="momis-lcd.jpg"
            alt={c.displayAlts[0]}
            widths={[340, 680]}
            sizes="(max-width: 660px) 100vw, 340px"
          />
          <Img
            src="momis-led.jpg"
            alt={c.displayAlts[1]}
            widths={[340, 680]}
            sizes="(max-width: 660px) 100vw, 340px"
          />
        </div>

        <h3>{c.onlineHeading}</h3>
        <p>{c.onlineDesc}</p>
        <div class="mrow-media mrow-media--2">
          <Img
            src="momis-wifi-portal.jpg"
            alt={c.onlineAlts[0]}
            widths={[340, 680]}
            sizes="(max-width: 660px) 100vw, 340px"
          />
          <Img
            src="momis-online-info.jpg"
            alt={c.onlineAlts[1]}
            widths={[340, 680]}
            sizes="(max-width: 660px) 100vw, 340px"
          />
        </div>
      </div>
    </div>
  </section>

  {/* --- Chapter 2: what keeps the service safe and measured -------- */}
  <section class="mgroup">
    <div class="wrap">
      <h2>{c.groupSafety}</h2>

      <div class="mrow" id="pocitanie">
        <span class="dt-num">{c.countNum}</span>
        <h3>{c.countHeading}</h3>
        <p>{c.countDesc}</p>
      </div>

      <div class="mrow" id="kamery">
        <span class="dt-num">{c.cameraNum}</span>
        <h3>{c.cameraHeading}</h3>
        <p>{c.cameraDesc}</p>
        <div class="mrow-media mrow-media--3">
          {
            cameraShots.map((src, i) => (
              <Img
                src={src}
                alt={c.cameraAlts[i]!}
                widths={[250, 500]}
                sizes="(max-width: 600px) 100vw, 250px"
              />
            ))
          }
        </div>
      </div>

      <div class="mrow" id="komunikacia">
        <span class="dt-num">{c.voiceNum}</span>
        <h3>{c.voiceHeading}</h3>
        <p>{c.voiceDesc}</p>
      </div>
    </div>
  </section>

  {/* --- Chapter 3: where it all comes together --------------------- */}
  <section class="mgroup mgroup--tint">
    <div class="wrap">
      <h2>{c.groupControl}</h2>

      <div class="mrow" id="hmi">
        <span class="dt-num">{c.hmiNum}</span>
        <h3>{c.hmiHeading}</h3>
        <p>{c.hmiDesc}</p>
        <div class="mrow-media mrow-media--1">
          <Img
            src="momis-kabina.jpg"
            alt={c.hmiAlt}
            widths={[680, 1243]}
            sizes="(max-width: 740px) 100vw, 680px"
          />
        </div>
      </div>
    </div>
  </section>

  <FinalCta lang={lang} />
</Base>
