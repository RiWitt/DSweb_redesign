---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Img from '../components/Img.astro';
import { momis } from '../content/pages';
import type { Lang } from '../i18n/ui';
import { homeAnchor } from '../lib/links';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = momis[lang];
const backHref = homeAnchor(lang, 'pis', 'pis');

const wifiShots = ['momis-wifi-0.jpg', 'momis-wifi-1.jpg', 'momis-wifi-2.jpg', 'momis-wifi-3.jpg'];
const cameraShots = ['momis-kamery-1.jpg', 'momis-kamery-2.jpg', 'momis-kamery-3.jpg'];
---

<Base lang={lang} page="pis" title={c.title} description={c.description}>
  <Breadcrumb
    lang={lang}
    page="pis"
    trail={[{ label: c.breadcrumbSection, href: backHref }, { label: 'MOMIS' }]}
  />

  <section class="sub-hero">
    <div class="wrap">
      <div class="eyebrow">{c.eyebrow}</div>
      <h1>{c.heading}</h1>
      <p class="lead">{c.lead}</p>
    </div>
  </section>

  <section class="sub-section">
    <div class="wrap">
      <span class="sec-label">{c.sectionLabel}</span>
      <h2>{c.sectionHeading}</h2>
      <p class="desc">{c.sectionDesc}</p>

      <div class="detail-block" id="wifi">
        <span class="dt-num">{c.wifiNum}</span>
        <h3>{c.wifiHeading}</h3>
        <p>{c.wifiDesc}</p>
        <div class="dt-img-quad">
          {
            wifiShots.map((src, i) => (
              <Img src={src} alt={c.wifiAlts[i]!} widths={[160, 320, 420]} sizes="(max-width: 600px) 45vw, 160px" />
            ))
          }
        </div>
      </div>

      <div class="detail-block" id="displeje">
        <span class="dt-num">{c.displayNum}</span>
        <h3>{c.displayHeading}</h3>
        <p>{c.displayDesc}</p>
        <div class="dt-img-pair">
          <Img src="momis-lcd.jpg" alt={c.displayAlts[0]} widths={[314, 628, 700]} sizes="(max-width: 600px) 100vw, 314px" />
          <Img src="momis-led.jpg" alt={c.displayAlts[1]} widths={[314, 628, 900]} sizes="(max-width: 600px) 100vw, 314px" />
        </div>

        <h3 style="margin-top:24px;">{c.onlineHeading}</h3>
        <p>{c.onlineDesc}</p>
        <div class="dt-img-pair-online">
          <Img class="oi-fill" src="momis-wifi-portal.jpg" alt={c.onlineAlts[0]} widths={[320, 640, 700]} sizes="(max-width: 600px) 100vw, 320px" />
          <Img class="oi-natural" src="momis-online-info.jpg" alt={c.onlineAlts[1]} widths={[340, 680, 1256]} sizes="(max-width: 600px) 100vw, 340px" />
        </div>
      </div>

      <div class="detail-block" id="pocitanie">
        <span class="dt-num">{c.countNum}</span>
        <h3>{c.countHeading}</h3>
        <p>{c.countDesc}</p>
      </div>

      <div class="detail-block" id="kamery">
        <span class="dt-num">{c.cameraNum}</span>
        <h3>{c.cameraHeading}</h3>
        <p>{c.cameraDesc}</p>
        <div class="dt-img-trio-photo">
          {
            cameraShots.map((src, i) => (
              <Img src={src} alt={c.cameraAlts[i]!} widths={[206, 412, 500]} sizes="(max-width: 600px) 100vw, 206px" />
            ))
          }
        </div>
      </div>

      <div class="detail-block" id="komunikacia">
        <span class="dt-num">{c.voiceNum}</span>
        <h3>{c.voiceHeading}</h3>
        <p>{c.voiceDesc}</p>
      </div>

      <div class="detail-block" id="hmi">
        <span class="dt-num">{c.hmiNum}</span>
        <h3>{c.hmiHeading}</h3>
        <p>{c.hmiDesc}</p>
        <Img class="dt-img" src="momis-kabina.jpg" alt={c.hmiAlt} widths={[640, 1243]} sizes="(max-width: 680px) 100vw, 640px" />
      </div>

      <a class="back-link" href={backHref}>{c.backLink}</a>
    </div>
  </section>
</Base>
