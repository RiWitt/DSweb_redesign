---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import DotAccent from '../components/DotAccent.astro';
import FinalCta from '../components/FinalCta.astro';
import { home } from '../content/home';
import type { Lang } from '../i18n/ui';
import { pageUrl, asset } from '../lib/links';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = home[lang];
const pis = pageUrl(lang, 'pis');

const clients = [
  { src: 'client-zssk.png', alt: 'ZSSK', cls: 'chip-img' },
  { src: 'client-zsr.jpg', alt: 'ŽSR', cls: 'chip-img chip-img-small' },
  { src: 'client-zos.jpg', alt: 'ŽOS Zvolen', cls: 'chip-img' },
  { src: 'client-slovnaft.jpg', alt: 'Slovnaft', cls: 'chip-img' },
];

const certsRailway = [
  { src: 'cert-en50155.png', alt: 'EN 50155' },
  { src: 'cert-en45545-2.png', alt: 'EN 45545-2' },
];

const certsIso = [
  { src: 'cert-iso-9001.png', alt: 'ISO 9001' },
  { src: 'cert-iso-14001.png', alt: 'ISO 14001' },
  { src: 'cert-iso-27001.png', alt: 'ISO 27001' },
  { src: 'cert-iso-45001.png', alt: 'ISO 45001' },
];

const partners = [
  { href: 'https://www.fortinet.com', src: 'partner-fortinet.webp', alt: 'Fortinet', cls: 'partner-img', w: 700 },
  { href: 'https://www.al-enterprise.com', src: 'partner-alcatel-lucent.jpg', alt: 'Alcatel-Lucent', cls: 'partner-img partner-img-lg', w: 300 },
  { href: 'https://www.cisco.com', src: 'partner-cisco.jpg', alt: 'Cisco', cls: 'partner-img partner-img-lg', w: 450 },
];
---

<Base lang={lang} page="home" title={c.title} description={c.description}>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">{c.heroEyebrow}</div>
      <h1>{c.heroHeading}<span class="h1-sub">{c.heroHeadingSub}</span></h1>
      <p class="lead">{c.heroLead}</p>
      <div class="hero-actions">
        <a class="btn-primary" href="#kontakt">{c.heroCtaPrimary}</a>
        <a class="btn-ghost" href="#pis">{c.heroCtaGhost}</a>
      </div>

      <div class="hero-visual">
        <Img
          src="hero-train.jpg"
          alt={c.heroImageAlt}
          widths={[640, 960, 1280, 1600, 2200]}
          sizes="(max-width: 1184px) 100vw, 1120px"
          loading="eager"
          fetchpriority="high"
        />
        <DotAccent />
      </div>

      <div class="clients" id="referencie">
        <div class="label">{c.clientsLabel}</div>
        <p class="clients-desc">{c.clientsDesc}</p>
        <div class="client-row">
          {clients.map((x) => <Img class={x.cls} src={x.src} alt={x.alt} widths={[240]} sizes="120px" />)}
          <span class="chip-frame">
            <Img src="client-slovenske-elektrarne.jpg" alt="Slovenské elektrárne" widths={[240]} sizes="120px" />
          </span>
        </div>
      </div>
    </div>
  </section>

  {/* --- Service 1: passenger information — light ------------------------ */}
  <section class="svc svc--light" id="pis">
    <div class="wrap svc-grid">
      <div class="svc-copy">
        <span class="eyebrow">{c.pisNum}</span>
        <h2><a href={pis}>{c.pisHeading}</a></h2>
        <p class="desc">{c.pisDesc}</p>
        <a class="btn-solid" href={pis}>
          {c.pisMore}<span class="btn-arrow" aria-hidden="true">&#8594;</span>
        </a>
      </div>
      <div class="svc-media svc-media--pair">
        <Img src="pis-headline.jpg" alt={c.pisPhoto1Alt} widths={[560, 1000]} sizes="(max-width: 900px) 100vw, 520px" />
        <Img src="pis-ovladanie.jpg" alt={c.pisPhoto2Alt} widths={[560, 1000]} sizes="(max-width: 900px) 100vw, 520px" />
      </div>
    </div>
    <div class="wrap" style="margin-top:40px;">
      <div class="feature-grid">
        {
          c.pisFeatures.map((f) => (
            <a class="feature" href={`${pis}#${f.hash}`}>
              <div class="ft">{f.title}</div>
              <div class="fd">{f.desc}</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* --- Service 2: critical infrastructure — dark, reversed ------------- */}
  <section class="svc svc--dark svc--rev" id="infra">
    <div class="wrap svc-grid">
      <div class="svc-copy">
        <span class="eyebrow">{c.infraNum}</span>
        <h2>{c.infraHeading}</h2>
        <p class="desc">{c.infraDesc}</p>
      </div>
      <div class="svc-media svc-media--panel">
        <Img src="diagram-lan-wan.png" alt={c.lanDiagramAlt} widths={[520, 813]} sizes="(max-width: 900px) 100vw, 500px" />
      </div>
    </div>

    <div class="wrap">
      <div class="svc-sub">
        <span class="sub-label">{c.xmcLabel}</span>
        <div>
          <p class="desc">{c.xmcDesc}</p>
          <div class="feature-grid">
            {
              c.xmcFeatures.map((f) => (
                <div class="feature">
                  <div class="ft">{f.title}</div>
                  <div class="fd">{f.desc}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="svc-sub">
        <span class="sub-label">{c.lanLabel}</span>
        <div>
          <p class="desc" style="margin-bottom:0;">{c.lanDesc}</p>
        </div>
      </div>
    </div>
  </section>

  {/* --- Service 3: cybersecurity — stone -------------------------------- */}
  <section class="svc svc--stone" id="cyber">
    <div class="wrap svc-grid">
      <div class="svc-copy">
        <span class="eyebrow">{c.cyberNum}</span>
        <h2>{c.cyberHeading}</h2>
        <p class="desc">{c.cyberDesc}</p>
      </div>
      <div class="svc-media svc-media--panel">
        <Img src="diagram-network-security.jpg" alt={c.cyberDiagramAlt} widths={[520, 1040, 1500]} sizes="(max-width: 900px) 100vw, 500px" />
      </div>
    </div>
    <div class="wrap" style="margin-top:40px;">
      <div class="feature-grid">
        {
          c.cyberFeatures.map((f) => (
            <div class="feature">
              <div class="ft">{f.title}</div>
              <div class="fd">{f.desc}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* --- Credentials: proof, not product -------------------------------- */}
  <section class="credentials">
    <div class="wrap">
      <div class="cred-block" id="cert">
        <div class="cred-copy">
          <span class="eyebrow">{c.certNum}</span>
          <h2>{c.certHeading}</h2>
          <p class="desc">{c.certDesc}</p>
        </div>
        <div class="cred-body">
          <div class="cert-row">
            {certsRailway.map((x) => <Img class="cert-badge cert-badge-en" src={x.src} alt={x.alt} widths={[156, 300]} sizes="78px" />)}
          </div>
          <p class="cred-note">{c.certIsoDesc}</p>
          <div class="cert-row">
            {certsIso.map((x) => <Img class="cert-badge cert-badge-iso" src={x.src} alt={x.alt} widths={[148, 200]} sizes="74px" />)}
          </div>
        </div>
      </div>

      <div class="cred-block" id="partneri">
        <div class="cred-copy">
          <span class="eyebrow">{c.partnersNum}</span>
          <h2>{c.partnersHeading}</h2>
          <p class="desc">{c.partnersDesc}</p>
        </div>
        <div class="partner-row">
          {
            partners.map((p) => (
              <a href={p.href} target="_blank" rel="noopener">
                <Img class={p.cls} src={p.src} alt={p.alt} widths={[280, p.w]} sizes="140px" />
              </a>
            ))
          }
          {/* SVG: shipped as-is, nothing for the image pipeline to improve. */}
          <a href="https://www.hitachienergy.com" target="_blank" rel="noopener">
            <img class="partner-img" src={asset('images/partner-hitachi-energy.svg')} alt="Hitachi Energy" width="140" height="58" />
          </a>
          <a href="https://www.extremenetworks.com" target="_blank" rel="noopener">
            <Img class="partner-img" src="partner-extreme-networks.jpg" alt="Extreme Networks" widths={[280, 500]} sizes="140px" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <FinalCta lang={lang} full />
</Base>
